generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum Gender {
  WOMEN
  MEN
  UNISEX
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING_PROVIDER
  PAID
  FAILED
  CANCELLED
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique @db.VarChar(191)
  passwordHash String            @db.VarChar(255)
  fullName     String            @db.VarChar(160)
  phone        String?           @db.VarChar(32)
  city         String?           @db.VarChar(100)
  avatarUrl    String?           @db.VarChar(500)
  role         UserRole          @default(BUYER)
  acceptedTermsAt DateTime
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  stores       Store[]
  sessions     Session[]
  favorites    Favorite[]
  cart         Cart?
  addresses    UserAddress[]
  preference   UserPreference?
  orders       Order[]

  @@index([role])
}

model UserAddress {
  id        String   @id @default(cuid())
  userId    String
  line1     String   @db.VarChar(250)
  city      String?  @db.VarChar(100)
  country   String   @default("CO") @db.Char(2)
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
}

model UserPreference {
  userId     String   @id
  styles     Json?
  categories Json?
  brands     Json?
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String   @db.VarChar(255)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Store {
  id          String    @id @default(cuid())
  ownerId     String
  slug        String    @unique @db.VarChar(191)
  name        String    @unique @db.VarChar(120)
  subtitle    String?   @db.VarChar(180)
  description String?   @db.Text
  city        String    @db.VarChar(100)
  imageUrl    String?   @db.VarChar(500)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  products    Product[]

  @@index([city, isActive])
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique @db.VarChar(191)
  name      String    @unique @db.VarChar(100)
  createdAt DateTime  @default(now())
  products  Product[]
}

model Collection {
  id          String              @id @default(cuid())
  slug        String              @unique @db.VarChar(191)
  name        String              @unique @db.VarChar(120)
  tagline     String?             @db.VarChar(250)
  description String?             @db.Text
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  products    ProductCollection[]
}

model ProductCollection {
  productId    String
  collectionId String
  position     Int       @default(0)
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId, position])
}

model Product {
  id            String         @id @default(cuid())
  storeId       String
  categoryId    String
  slug          String         @unique @db.VarChar(191)
  name          String         @db.VarChar(180)
  description   String         @db.Text
  gender        Gender         @default(UNISEX)
  referenceTags Json?
  price         Decimal        @db.Decimal(12, 2)
  compareAtPrice Decimal?      @db.Decimal(12, 2)
  badge         String?        @db.VarChar(80)
  status        ProductStatus  @default(DRAFT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  variants      ProductVariant[]
  favorites     Favorite[]
  cartItems     CartItem[]
  collections   ProductCollection[]
  orderItems    OrderItem[]

  @@index([storeId, status])
  @@index([categoryId, status])
  @@index([gender, status])
  @@index([price, status])
}

model NewsletterSubscription {
  id             String   @id @default(cuid())
  email          String   @unique @db.VarChar(191)
  subscribedAt   DateTime @default(now())
  unsubscribedAt DateTime?
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String   @db.VarChar(500)
  alt       String?  @db.VarChar(200)
  position  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  sku       String   @unique @db.VarChar(100)
  size      String   @db.VarChar(20)
  colorName String   @db.VarChar(50)
  colorHex  String   @db.VarChar(7)
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size, colorName])
  @@index([productId, stock])
}

model Favorite {
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  productId String
  variantId String
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([productId])
}

model Order {
  id             String        @id @default(cuid())
  userId         String
  idempotencyKey String        @unique @db.VarChar(191)
  status         OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus  PaymentStatus @default(PENDING_PROVIDER)
  currency       String        @default("COP") @db.Char(3)
  subtotal       Decimal       @db.Decimal(12, 2)
  shipping       Decimal       @default(0) @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  expiresAt      DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  items          OrderItem[]

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  productId      String
  variantId      String
  productName    String         @db.VarChar(180)
  productSlug    String         @db.VarChar(191)
  variantSku     String         @db.VarChar(100)
  size           String         @db.VarChar(20)
  colorName      String         @db.VarChar(50)
  unitPrice      Decimal        @db.Decimal(12, 2)
  quantity       Int
  lineTotal      Decimal        @db.Decimal(12, 2)
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
}
