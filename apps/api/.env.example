NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://darkshop:darkshop@localhost:3306/darkshop
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=darkshop_admin
DATABASE_PASSWORD=darkshop
DATABASE_NAME=darkshop
# Solo para `npm run db:local:init`; debe apuntar a una cuenta administradora
# de una instalación local de MySQL. No es necesaria al usar Docker.
MYSQL_ADMIN_URL=mysql://root:change-this-local-root-password@localhost:3306/mysql
# Obligatoria únicamente para cargar los datos de demostración locales.
SEED_SELLER_PASSWORD=replace-with-a-local-seed-password
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173
UPLOAD_MAX_FILE_SIZE=5242880
