    "eslint-plugin-prettier": "^5.5.4",
    "fast-check": "^4.10.2",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
