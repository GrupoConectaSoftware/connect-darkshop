    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.1.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "mariadb": "^3.4.5",
    "multer": "^2.0.2",
