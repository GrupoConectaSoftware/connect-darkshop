{
  "name": "connect-darkshop-workspace",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "npm --prefix apps/api run start:dev",
    "build:web": "npm --prefix apps/web run build",
    "build:api": "npm --prefix apps/api run build",
    "test:api": "npm --prefix apps/api test",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down"
  }
}
